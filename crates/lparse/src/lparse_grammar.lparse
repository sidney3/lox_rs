#![allow(clippy::all)]

use crate::lparse_frontend::BoundLeaf;
use crate::lparse_frontend::BoundRule;
use crate::lparse_frontend::Ident;
use crate::lparse_frontend::LGrammar;
use crate::lparse_frontend::LNode;
use crate::lparse_frontend::LParseToken;
use crate::lparse_frontend::LRule;
use crate::lparse_frontend::ProductionDefinition;
use lasso::Rodeo;
use lexer::Tokens;
use lox_derive::Ordinal;
use strum::Display;
use lparse;

goal_rule = LGrammar;
token_type = LParseToken;

BoundLeaf {
	[_:LSquareBracket] [bind_to:Ident] [_:Colon] [token: Ident] [_: RSquareBracket] => % BoundLeaf{token: token, bind_to: bind_to } %,
};


BoundRule {
	[_:LAngleBracket] [bind_to:Ident] [_:Colon] [token: Ident] [_: RAngleBracket] => % BoundRule{rule: token, bind_to: bind_to } %,
};

BoundKleeneRule: %BoundRule% {
	[_:LAngleBracket] [bind_to:Ident] [_:Colon] [token: Ident] [_: Asterisk] [_: RAngleBracket] => % BoundRule{rule: token, bind_to } %,
};

LNode {
	<leaf:BoundLeaf> => % LNode::Leaf(leaf) %,
	<rule:BoundRule> => % LNode::Rule(rule) %,
	<rule:BoundKleeneRule> => % LNode::Kleene(rule, ()) %,
};


ProductionDefinition {
	<definition:LNode*> [_:Equals] [_:RAngleBracket] [semantic_action:EmbeddedRust] [_:Comma] => % ProductionDefinition{ definition: definition, semantic_action: semantic_action } %,
};

LRule {
	[name:Ident] [_:Colon] [return_type:EmbeddedRust] [_:LCurlyBrace] <productions:ProductionDefinition*> [_:RCurlyBrace] [_:Semicolon] => %
		LRule {
			name: name,
			return_type: Some(return_type),
			productions,
		}
	%,
	[name:Ident] [_:LCurlyBrace] <productions:ProductionDefinition*> [_:RCurlyBrace] [_:Semicolon] => %
		LRule {
			name: name,
			return_type: None,
			productions,
		}
	%,
};

SetGoalRule: %Ident% {
	[_:GoalRule] [_:Equals] [goalrule:Ident] [_:Semicolon] => % goalrule %,
};

SetTokenType: %Ident% {
	[_:TokenType] [_:Equals] [tokentype:Ident] [_:Semicolon] => % tokentype %,
};

Preamble: %Ident% {
	[import:RustImport] => %import%,
	[directive:RustDirective] => %directive%,
};

LGrammar {
 <preamble:Preamble*> <goalrule:SetGoalRule> <tokentype:SetTokenType> <rules: LRule*> => %
	 LGrammar {
	 	preamble,
		goal_rule: goalrule,
		token_type: tokentype,
		rules,
	 }
 %,
};
