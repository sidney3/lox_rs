use crate::lparse_grammar::{LGrammar,LParseToken,BoundLeaf,BoundRule,LRule};
use crate::lparse_grammar::Ident;
use crate::Production;
use crate::Grammar;

goal_rule = LGrammar;
token_type = LParseToken;

BoundLeaf: %BoundLeaf% {
	[_1:LSquareBracket] [bind_to:Ident] [_2:Colon] [token: Ident] [_3: RSquareBracket] => % BoundLeaf{token: token.lexeme, bind_to: bind_to.lexeme } %,
};


BoundRule: %BoundRule% {
	[_1:LAngleBracket] [bind_to:Ident] [_2:Colon] [token: Ident] [_3: RAngleBracket] => % BoundRule{token: token.lexeme, bind_to: bind_to.lexeme } %,
};

Node: %LNode% {
	<leaf:BoundLeaf> => % LNode::Leaf(leaf) %,
	<rule:BoundRule> => % LNode::Rule(rule) %,
};

Nodes: %Vec<Node>% {
	=> % Vec::new() %,
	<first:Node> <rest:Nodes> => %
		{
			let mut all = rest;
			all.push(first);
			all
		}
	%,
};

Production: %ProductionDefinition% {
	<definition:Nodes> [_1:Equals] [_2:RangleBracket] [semantic_action:EmbeddedRust] [_3:Semicolon] [_4:Comma] => % ProductionDefinition{ definition: definition.lexeme, semantic_action: semantic_action.lexeme } %,
};

Productions: %Vec<ProductionDefinition>% {
	=> % Vec::new() %,
	<first:Production> <rest:Productions> => %
		{
			let mut all = rest;
			rest.push(first);
			rest
		}
	%,
};

Rule: %LRule% {
	[name:Ident] [_1:Colon] [return_type:Ident] [_2:LCurlyBrace] <productions:Productions> [_3:RCurlyBrace] [_4:Semicolon] => %
		LRule {
			name: name.lexeme,
			return_type: return_type.lexeme,
			productions,
		}
	%,
};

Rules: %Vec<LRule>% {
	=> % Vec::new() %,
	<first:Rule> <rest:Rules> => %
		{
			let mut all = rest;
			rest.push(first);
			rest
		}
	%,
};

SetGoalRule: %Ident% {
	[_1:GoalRule] [_2:Equal] [goalrule:Ident] => % goalrule.lexeme %,
};

SetTokenType: %Ident% {
	[_1:TokenType] [_2:Equal] [tokentype:Ident] => % tokentype.lexeme %,
};

Preamble: %Vec<Ident>% {
	=> % Vec::new() %,
	[import:RustImport] <rest:Preamble> => %
		{
			let mut all = rest;
			rest.push(import);
			all
		}
	%,
};

Grammar: %LGrammar% {
 <preamble:Preamble> <goalrule:SetGoalRule> <tokentype:SetTokenType> <rules: Rules> => %
	 LGrammar {
	 	preamble,
		goal_rule: goalrule,
		token_type: tokentype,
		rules,
	 }
 %,
};
