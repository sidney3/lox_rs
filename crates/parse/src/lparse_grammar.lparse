use crate::lparse_frontend::BoundLeaf;
use crate::lparse_frontend::BoundRule;
use crate::lparse_frontend::Ident;
use crate::lparse_frontend::LGrammar;
use crate::lparse_frontend::LNode;
use crate::lparse_frontend::LParseToken;
use crate::lparse_frontend::LRule;
use crate::lparse_frontend::ProductionDefinition;
use lasso::Rodeo;
use lexer::Tokens;
use lox_derive::Ordinal;
use strum::Display;
use parse;

goal_rule = Grammar;
token_type = LParseToken;

BoundLeaf: %BoundLeaf% {
	[_:LSquareBracket] [bind_to:Ident] [_:Colon] [token: Ident] [_: RSquareBracket] => % BoundLeaf{token: token, bind_to: bind_to } %,
};


BoundRule: %BoundRule% {
	[_:LAngleBracket] [bind_to:Ident] [_:Colon] [token: Ident] [_: RAngleBracket] => % BoundRule{rule: token, bind_to: bind_to } %,
};

Node: %LNode% {
	<leaf:BoundLeaf> => % LNode::Leaf(leaf) %,
	<rule:BoundRule> => % LNode::Rule(rule) %,
};

Nodes: %Vec<LNode>% {
	=> % Vec::new() %,
	<head:Nodes> <node:Node>=> %
		{
			let mut all = head;
			all.push(node);
			all
		}
	%,
};

Production: %ProductionDefinition% {
	<definition:Nodes> [_:Equals] [_:RAngleBracket] [semantic_action:EmbeddedRust] [_:Comma] => % ProductionDefinition{ definition: definition, semantic_action: semantic_action } %,
};

Productions: %Vec<ProductionDefinition>% {
	=> % Vec::new() %,
	<head:Productions><production:Production>=> %
		{
			let mut all = head;
			all.push(production);
			all
		}
	%,
};

Rule: %LRule% {
	[name:Ident] [_:Colon] [return_type:EmbeddedRust] [_:LCurlyBrace] <productions:Productions> [_:RCurlyBrace] [_:Semicolon] => %
		LRule {
			name: name,
			return_type: return_type,
			productions,
		}
	%,
};

Rules: %Vec<LRule>% {
	=> % Vec::new() %,
	<head:Rules> <rule:Rule>=> %
		{
			let mut all = head;
			all.push(rule);
			all
		}
	%,
};

SetGoalRule: %Ident% {
	[_:GoalRule] [_:Equals] [goalrule:Ident] [_:Semicolon] => % goalrule %,
};

SetTokenType: %Ident% {
	[_:TokenType] [_:Equals] [tokentype:Ident] [_:Semicolon] => % tokentype %,
};

Preamble: %Vec<Ident>% {
	=> % Vec::new() %,
	<head:Preamble> [import:RustImport]=> %
		{
			let mut all = head;
			all.push(import);
			all
		}
	%,
};

Grammar: %LGrammar% {
 <preamble:Preamble> <goalrule:SetGoalRule> <tokentype:SetTokenType> <rules: Rules> => %
	 LGrammar {
	 	preamble,
		goal_rule: goalrule,
		token_type: tokentype,
		rules,
	 }
 %,
};
