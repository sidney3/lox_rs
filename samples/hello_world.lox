class Dog {
	init(name) {
		print "Hi from ctor. assigning name=" + name;
		this.name = name;
	}

	fun bark() {
		return "woof";
	}

	fun set_name(name) {
		this.name = name;
	}

	fun get_name() {
		return this.name;
	}

	fun do_set_name(name) {
		this.set_name(name);
	}
};

print "1";
var dog = Dog("fido");
print "2";
assert dog.bark() == "woof";

print "3";
var bark = dog.bark;
print "4";
assert bark() == dog.bark();

dog.set_name("Fido");
assert dog.get_name() == "Fido";

print "5";
var fido = Dog("Fido");

assert fido == dog;

dog.do_set_name("Maggie");
print "6";

assert dog.get_name() == "Maggie";
assert fido != dog;
