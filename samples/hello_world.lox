class Dog {
	init(name) {
		print("Hello from constructor. Assigning: " + name);
		this.name = name;
	}

	fun bark() {
		print("Hello from bark.");
		return "woof";
	}

	fun set_name(name) {
		this.name = name;
	}

	fun get_name() {
		return this.name;
	}

	fun do_set_name(name) {
		this.set_name(name);
	}
};

var fido = Dog("Fido");
print(fido.bark());
