class MyClass {};

assert MyClass() == MyClass(); 

var durable = MyClass();
assert durable == MyClass();


var x = MyClass();
x.a = "a";
assert x.a == "a";
x.a = "b";
assert x.a == "b";
x.a = x.a;
assert x.a == "b";

x.once = MyClass();
x.once.twice = MyClass();
x.once.twice.thrice = MyClass();
x.once.twice.thrice.a = "b";
assert x.a == x.once.twice.thrice.a;

x.init = MyClass;
var y = x.init();
assert y == MyClass();

class Dog {
	fun bark() {
		return "woof";
	}

	fun set_name(name) {
		this.name = name;
	}

	fun get_name() {
		return this.name;
	}

	fun do_set_name(name) {
		this.set_name(name);
	}
};

var dog = Dog();
assert dog.bark() == "woof";

var bark = dog.bark;
assert bark() == dog.bark();

dog.set_name("Fido");
assert dog.get_name() == "Fido";

var fido = Dog();
fido.set_name("Fido");

assert fido == dog;

dog.do_set_name("Maggie");

assert dog.get_name() == "Maggie";
assert fido != dog;
