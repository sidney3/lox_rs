class MyClass {};

assert MyClass() == MyClass(); 

class OtherClass {};

assert OtherClass() != MyClass();

var durable = MyClass();
assert durable == MyClass();


var x = MyClass();
x.a = "a";
assert x.a == "a";
x.a = "b";
assert x.a == "b";
x.a = x.a;
assert x.a == "b";

x.once = MyClass();
x.once.twice = MyClass();
x.once.twice.thrice = MyClass();
x.once.twice.thrice.a = "b";
assert x.a == x.once.twice.thrice.a;
