{
	fun inner() {
		var x = 9;

		fun f(equal_to) {
			assert x == equal_to;
		}

		f(9);

		x = 10;

		f(10);
		f(10);
	}

	inner();
}


{
	var x = 2;
	var z = 9;

	fun outer() {

		fun inner() {
			z = z + x;
			return z;
		}

		z = 4;

		return inner;
	}

	var f = outer();

	assert z == 4;
	assert f() == 6;
	assert z == 6;
	assert f() == 8;
}


{
	fun outer() {
		var z = 4;
		fun inner() {
			z = z + 2;
			return z;
		}

		fun middle() {
			fun even_more_middle() {
				return inner();
			}

			return even_more_middle();
		}

		return middle;
	}

	var f = outer();

	assert f() == 6;
	assert f() == 8;
	assert f() == 10;
	assert f() == 12;
}
