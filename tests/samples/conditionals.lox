var x = 9;

if true {
	x = 2;
	x = 10;
}

assert x == 10;

if 2 {
	x = 9;
}

assert x == 9;

if 0 {
	x = 2;
}

assert x == 9;

var s = "";

if 2 > 3 {
	s = "2 is greater than 3";
} else {
	s = "3 is greater than 2";
}

assert s == "3 is greater than 2";


var z = 3;
var m = "";

if z == 1 {
	m = "1";
} else if z == 2 {
	m = "2";
} else if z == 3 {
  m = "3";
}

assert m == "3";


if z == 1 {
	m = "1";
} else if z == 2 {
	m = "2";
} else if z == 3 {
  m = "3";
} else {
	m = "4";
}

assert m == "3";

var x = 0;
var i = 0;
while i < 5 {
	i = i + 1;
	x = x + 1;
}

assert x == 5;
