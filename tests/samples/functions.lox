fun f(arg) {
	return "Hello " + arg;
}

assert(f("World") == "Hello World");
assert(f("Sidney") == "Hello Sidney");

var z = f;

assert(f("World") == "Hello World");

fun f(g) {
	return g(4);
}

fun h(x) {
  return x + 5;
}

assert(f(h) == 9);

fun square(f, elt) {
	return f(f(elt));
}

fun times_5(x) {
	return x * 5;
}

assert(square(times_5, 5) == 125);
