class Base {
	foo() {
		return "base_foo";
	}
	bar() {
		return "base_bar";
	}
}

class Derived < Base {
	foo() {
		return "derived_foo";
	}
}

var derived = Derived();
assert derived.foo() == "derived_foo";
assert derived.bar() == "base_bar";

class A {
	f_init() {
		this.name = "A";
	}
	method() { return this.name + "_method"; }
}

class B < A {
	f_init() {
		super.f_init();
	}
	method() { return "B_method"; }

	test() { return super.method(); }
}

class C < B {
	init() {
		super.f_init();
	}
}

assert C().test() == "A_method";
